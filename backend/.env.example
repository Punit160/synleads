# Local MySQL (default — port 3306, no Docker required)
# Run once: npm run db:setup
DATABASE_URL="mysql://leadflow:leadflow@127.0.0.1:3306/leadflow"
SHADOW_DATABASE_URL="mysql://root@127.0.0.1:3306/leadflow"

# Optional Docker MySQL on port 3307: npm run db:setup:docker
# DATABASE_URL="mysql://leadflow:leadflow@127.0.0.1:3307/leadflow"
# SHADOW_DATABASE_URL="mysql://root:root@127.0.0.1:3307/leadflow"

# Production example:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/leadflow?sslaccept=strict"

JWT_SECRET="change-me-in-production-use-long-random-string"
FRONTEND_URL="http://localhost:3000"
# Subdomain company portals: synentrix-demo.localhost:3000/login (dev) or slug.synentrixflow.com (prod)
APP_DOMAIN="localhost:3000"
# Production example:
# FRONTEND_URL="https://synentrixflow.com"
# APP_DOMAIN="synentrixflow.com"
PORT=4001
NODE_ENV="development"
