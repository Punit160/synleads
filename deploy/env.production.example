# ── Copy to VPS and split into backend/.env and frontend/.env.local ──

# ── backend/.env ──
DATABASE_URL="mysql://leadflow:STRONG_PASSWORD@127.0.0.1:3306/leadflow"
SHADOW_DATABASE_URL="mysql://root:ROOT_PASSWORD@127.0.0.1:3306/leadflow"

JWT_SECRET="generate-a-long-random-string-at-least-64-chars"
NODE_ENV=production
PORT=4001

# Apex marketing / portal site
FRONTEND_URL="https://synentrixflow.com"
# Enables company portals: https://COMPANY.synentrixflow.com/login
APP_DOMAIN="synentrixflow.com"

# ── frontend/.env.local ──
NEXT_PUBLIC_APP_DOMAIN=synentrixflow.com
# Internal — Next.js proxies /api/* to backend (do not expose publicly)
API_URL=http://127.0.0.1:4001
