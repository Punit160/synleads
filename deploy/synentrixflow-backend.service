[Unit]
Description=Synentrix Flow API (backend)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/synentrixflow/backend
Environment=NODE_ENV=production
EnvironmentFile=/var/www/synentrixflow/backend/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
