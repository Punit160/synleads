  workspaceId String   @map("workspace_id")
  name        String
  field       String
  operator    String
  value       String?
  points      Int
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, priority])
  @@map("lead_scoring_rules")
}

model SlaPolicy {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique @map("workspace_id")
  enabled            Boolean  @default(true)
  firstResponseHours Int      @default(24) @map("first_response_hours")
  escalateAfterHours Int      @default(48) @map("escalate_after_hours")
  escalateToManager  Boolean  @default(true) @map("escalate_to_manager")
  notifyOnBreach     Boolean  @default(true) @map("notify_on_breach")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

model CustomFieldDefinition {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  entityType  String   @default("lead") @map("entity_type")
  key         String
  label       String
  fieldType   String   @map("field_type")
  options     String?  @db.Text
  required    Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId, entityType])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  fieldId     String   @map("field_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  value       String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([workspaceId, entityType, entityId])
  @@map("custom_field_values")
}

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String?  @map("user_id")
  name        String
  entityType  String   @default("lead") @map("entity_type")
  filters     Json
  isShared    Boolean  @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType])
  @@map("saved_views")
}

model SystemError {
  id              String    @id @default(cuid())
  reference       String    @unique
  severity        String    @default("error")
  status          String    @default("open")
  source          String    @default("api")
  message         String    @db.Text
  technical       String?   @db.Text
  route           String?
  method          String?
  statusCode      Int?      @map("status_code")
  workspaceId     String?   @map("workspace_id")
  userId          String?   @map("user_id")
  userEmail       String?   @map("user_email")
  userAgent       String?   @map("user_agent") @db.Text
  ip              String?
  metadata        Json?
  resolvedAt      DateTime? @map("resolved_at")
  resolvedById    String?   @map("resolved_by_id")
  resolutionNotes String?   @map("resolution_notes") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([workspaceId])
  @@map("system_errors")
}
