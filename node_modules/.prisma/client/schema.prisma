generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  name      String
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace?          @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  managedMembers    WorkspaceMember[]   @relation("MemberManager")
  leads             Lead[]              @relation("LeadOwner")
  contacts          Contact[]           @relation("ContactOwner")
  accounts          Account[]           @relation("AccountOwner")
  deals             Deal[]              @relation("DealOwner")
  activities        Activity[]          @relation("ActivityOwner")
  followUps         FollowUp[]          @relation("FollowUpOwner")
  communications    Communication[]     @relation("CommunicationOwner")
  leadNotes         LeadNote[]
  leadTimeline      LeadTimelineEvent[]
  assignedTasks     Task[]              @relation("TaskAssignee")
  createdTasks      Task[]              @relation("TaskCreator")
  quotations        Quotation[]         @relation("QuotationCreator")
  approvedQuotes    Quotation[]         @relation("QuotationApprover")
  notifications     Notification[]
  calendarEvents    CalendarEvent[]
  uploadedDocs      Document[]
  ledTeams          Team[]              @relation("TeamLeader")
  teamMemberships   TeamMember[]
  backupAssignRules AssignmentRule[]    @relation("RuleBackupUser")
}

model Workspace {
  id                           String   @id @default(cuid())
  name                         String
  slug                         String?  @unique
  userId                       String   @unique
  status                       String   @default("active")
  provisionedByPlatformAdminId String?  @map("provisioned_by_platform_admin_id")
  interestedPackage            String?  @map("interested_package")
  salesNotes                   String?  @map("sales_notes") @db.Text
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  // Company profile & quotation branding
  companyLegalName         String?
  address                  String?
  city                     String?
  state                    String?
  pincode                  String?
  country                  String? @default("India")
  phone                    String?
  email                    String?
  website                  String?
  gstin                    String?
  pan                      String?
  logoPath                 String?
  signaturePath            String?
  stampPath                String?
  authorizedSignatoryName  String?
  authorizedSignatoryTitle String?
  quoteTerms               String?

  // Lead automation & integrations
  leadApiKey        String? @unique @map("lead_api_key")
  autoAssignEnabled Boolean @default(false) @map("auto_assign_enabled")
  autoAssignMode    String  @default("round_robin") @map("auto_assign_mode")
  autoAssignIndex   Int     @default(0) @map("auto_assign_index")

  owner                  User                    @relation("WorkspaceOwner", fields: [userId], references: [id], onDelete: Cascade)
  provisionedBy          PlatformAdmin?          @relation("ProvisionedCompanies", fields: [provisionedByPlatformAdminId], references: [id], onDelete: SetNull)
  platformSales          PlatformSale[]
  subscriptionHistory    SubscriptionHistory[]
  members                WorkspaceMember[]
  subscription           Subscription?
  stages                 PipelineStage[]
  leads                  Lead[]
  contacts               Contact[]
  accounts               Account[]
  deals                  Deal[]
  activities             Activity[]
  followUps              FollowUp[]
  communications         Communication[]
  tasks                  Task[]
  quotations             Quotation[]
  customers              Customer[]
  documents              Document[]
  notifications          Notification[]
  calendarEvents         CalendarEvent[]
  auditLogs              AuditLog[]
  integrations           WorkspaceIntegration[]
  teams                  Team[]
  assignmentRules        AssignmentRule[]
  workflowRules          WorkflowRule[]
  leadScoringRules       LeadScoringRule[]
  slaPolicy              SlaPolicy?
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  savedViews             SavedView[]
  systemErrors           SystemError[]
}

model WorkspaceMember {
  id            String   @id @default(cuid())
  workspaceId   String
  userId        String
  role          String   @default("employee")
  managerUserId String?
  status        String   @default("active")
  isAvailable   Boolean  @default(true) @map("is_available")
  maxLeadLimit  Int?     @map("max_lead_limit")
  createdAt     DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  managerUser User?     @relation("MemberManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId, managerUserId])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  leaderId    String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leader    User?            @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members   TeamMember[]
  rules     AssignmentRule[]

  @@index([workspaceId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model AssignmentRule {
  id                 String   @id @default(cuid())
  workspaceId        String
  name               String
  priority           Int      @default(0)
  isActive           Boolean  @default(true)
  teamId             String?
  distributionMethod String   @default("round_robin") @map("distribution_method")
  sourceFilter       String?  @map("source_filter")
  cityFilter         String?  @map("city_filter")
  stateFilter        String?  @map("state_filter")
  productFilter      String?  @map("product_filter")
  maxLeadLimit       Int?     @map("max_lead_limit")
  backupUserId       String?  @map("backup_user_id")
  assigneeUserIds    String   @map("assignee_user_ids") @db.Text
  roundRobinIndex    Int      @default(0) @map("round_robin_index")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  backupUser User?     @relation("RuleBackupUser", fields: [backupUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isActive, priority])
}

model Subscription {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  package     String   @default("1month") @map("plan_package")
  status      String   @default("active")
  startsAt    DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model SubscriptionHistory {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  package         String
  previousPackage String?   @map("previous_package")
  changeType      String    @default("initial") @map("change_type")
  startsAt        DateTime  @map("starts_at")
  expiresAt       DateTime  @map("expires_at")
  endedAt         DateTime? @map("ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("subscription_history")
}

model PlatformAdmin {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  password    String
  role        String   @default("operator")
  status      String   @default("active")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy            PlatformAdmin?  @relation("PlatformAdminCreated", fields: [createdById], references: [id], onDelete: SetNull)
  created              PlatformAdmin[] @relation("PlatformAdminCreated")
  provisionedCompanies Workspace[]     @relation("ProvisionedCompanies")
  platformSales        PlatformSale[]  @relation("PlatformSales")
}

model PlatformSale {
  id                    String   @id @default(cuid())
  workspaceId           String   @map("workspace_id")
  package               String
  previousPackage       String?  @map("previous_package")
  changeType            String   @default("initial") @map("change_type")
  amountInr             Int      @map("amount_inr")
  listPriceInr          Int?     @map("list_price_inr")
  creditInr             Int      @default(0) @map("credit_inr")
  remainingDays         Int?     @map("remaining_days")
  soldByPlatformAdminId String?  @map("sold_by_platform_admin_id")
  notes                 String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  soldBy    PlatformAdmin? @relation("PlatformSales", fields: [soldByPlatformAdminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([soldByPlatformAdminId])
  @@map("platform_sales")
}

model PipelineStage {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @map("stage_order")
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@index([workspaceId, order])
  @@map("pipeline_stages")
}

model Lead {
  id                  String    @id @default(cuid())
  workspaceId         String
  ownerId             String?
  leadNumber          String    @default("LF-00000")
  firstName           String
  lastName            String?
  email               String?
  phone               String?
  alternatePhone      String?
  company             String?
  title               String?
  address             String?
  city                String?
  state               String?
  country             String?   @default("India")
  pinCode             String?
  industry            String?
  website             String?
  source              String?   @default("Manual Entry")
  status              String    @default("new")
  priority            String    @default("medium")
  budget              Float?
  requirement         String?
  expectedClosingDate DateTime?
  remarks             String?
  score               Int       @default(0)
  notes               String?
  firstResponseAt     DateTime? @map("first_response_at")
  slaDueAt            DateTime? @map("sla_due_at")
  slaBreached         Boolean   @default(false) @map("sla_breached")
  slaEscalatedAt      DateTime? @map("sla_escalated_at")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User?               @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities     Activity[]
  followUps      FollowUp[]
  communications Communication[]
  leadNotes      LeadNote[]
  attachments    LeadAttachment[]
  timeline       LeadTimelineEvent[]
  tasks          Task[]
  quotations     Quotation[]
  customer       Customer?

  @@unique([workspaceId, leadNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, city])
  @@index([workspaceId, priority])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, slaDueAt])
  @@index([workspaceId, slaBreached])
}

model FollowUp {
  id               String    @id @default(cuid())
  workspaceId      String
  leadId           String
  ownerId          String?
  type             String
  scheduledAt      DateTime
  reminderAt       DateTime?
  notes            String?
  nextFollowUpDate DateTime?
  completed        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner     User?     @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scheduledAt])
  @@index([leadId])
}

model Communication {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  ownerId     String?
  channel     String
  direction   String   @default("outbound")
  subject     String?
  body        String?
  phoneNumber String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner     User?     @relation("CommunicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  content   String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model LeadAttachment {
  id         String   @id @default(cuid())
  leadId     String
  fileName   String
  fileSize   Int
  mimeType   String
  filePath   String
  uploadedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadTimelineEvent {
  id          String   @id @default(cuid())
  leadId      String
  userId      String?
  type        String
  title       String
  description String?
  createdAt   DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Account {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String?
  name        String
  industry    String?
  website     String?
  phone       String?
  city        String?
  state       String?
  country     String?  @default("India")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User?      @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  customers  Customer[]
  documents  Document[]
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String?
  ownerId     String?
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  title       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner      User?       @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
  customers  Customer[]
  documents  Document[]
}

model Deal {
  id                String    @id @default(cuid())
  workspaceId       String
  stageId           String
  accountId         String?
  contactId         String?
  ownerId           String?
  name              String
  amount            Float     @default(0)
  probability       Int?
  expectedCloseDate DateTime?
  status            String    @default("open")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closedAt          DateTime?

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
  documents  Document[]
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  ownerId     String?
  leadId      String?
  contactId   String?
  accountId   String?
  dealId      String?
  type        String
  subject     String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// ── Task Management ──
model Task {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String?
  assigneeId  String?
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("medium")
  status      String    @default("pending")
  reminderAt  DateTime?
  completedAt DateTime?
  leadId      String?
  dealId      String?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([assigneeId])
}

// ── Quotation Management ──
model Quotation {
  id           String    @id @default(cuid())
  workspaceId  String
  quoteNumber  String
  leadId       String?
  dealId       String?
  contactId    String?
  createdById  String?
  approvedById String?
  status       String    @default("draft")
  subtotal     Float     @default(0)
  taxRate      Float     @default(18)
  taxAmount    Float     @default(0)
  discount     Float     @default(0)
  total        Float     @default(0)
  validUntil   DateTime?
  notes        String?
  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal       Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact    Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy  User?           @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?           @relation("QuotationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items      QuotationItem[]
  history    QuoteHistory[]

  @@unique([workspaceId, quoteNumber])
  @@index([workspaceId, status])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  name        String
  description String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  taxRate     Float   @default(18)
  discount    Float   @default(0)
  lineTotal   Float   @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuoteHistory {
  id          String   @id @default(cuid())
  quotationId String
  action      String
  notes       String?
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ── Customer Management (post-conversion) ──
model Customer {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String?  @unique
  contactId   String?
  accountId   String?
  name        String
  email       String?
  phone       String?
  company     String?
  convertedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account        Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  orders         CustomerOrder[]
  invoices       CustomerInvoice[]
  payments       CustomerPayment[]
  serviceHistory ServiceHistory[]
  documents      Document[]

  @@index([workspaceId])
}

model CustomerOrder {
  id          String   @id @default(cuid())
  customerId  String
  orderNumber String
  amount      Float    @default(0)
  status      String   @default("pending")
  orderDate   DateTime @default(now())
  notes       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerInvoice {
  id            String    @id @default(cuid())
  customerId    String
  invoiceNumber String
  amount        Float     @default(0)
  status        String    @default("unpaid")
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments CustomerPayment[]
}

model CustomerPayment {
  id         String   @id @default(cuid())
  customerId String
  invoiceId  String?
  amount     Float    @default(0)
  method     String   @default("bank_transfer")
  paidAt     DateTime @default(now())
  reference  String?

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  CustomerInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model ServiceHistory {
  id          String   @id @default(cuid())
  customerId  String
  title       String
  description String?
  serviceDate DateTime @default(now())
  status      String   @default("completed")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ── Document Management ──
model Document {
  id           String   @id @default(cuid())
  workspaceId  String
  fileName     String
  fileSize     Int
  mimeType     String
  filePath     String
  category     String   @default("general")
  leadId       String?
  dealId       String?
  accountId    String?
  contactId    String?
  customerId   String?
  uploadedById String?
  uploadedAt   DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, category])
}

// ── Notifications ──
model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  type        String
  title       String
  message     String
  channel     String   @default("browser")
  read        Boolean  @default(false)
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ── Calendar ──
model CalendarEvent {
  id          String    @id @default(cuid())
  workspaceId String
  ownerId     String?
  title       String
  type        String    @default("event")
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  location    String?
  description String?
  completed   Boolean   @default(false)
  leadId      String?
  dealId      String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
}

// ── Audit log (admin actions) ──
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  details     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model WorkspaceIntegration {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  integrationId String    @map("integration_id")
  enabled       Boolean   @default(false)
  config        Json      @default("{}")
  lastSyncAt    DateTime? @map("last_sync_at")
  connectedAt   DateTime? @map("connected_at")
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, integrationId])
  @@map("workspace_integrations")
}

model WorkflowRule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0)
  trigger     String
  conditions  Json     @default("[]")
  actions     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, priority])
  @@map("workflow_rules")
}

model LeadScoringRule {
